# Copia este archivo a .env en tu VPS antes de ejecutar:
#   cp .env.example .env
# Nunca subas .env a Git.

# -----------------------------------------------------------------------------
# 1. Dominio y HTTPS (Caddy)
# -----------------------------------------------------------------------------
# Con dominio propio apuntando a la IP del VPS (recomendado para HTTPS automatico):
# SITE_ADDRESS=app.tudominio.com
# Sin dominio (solo HTTP por IP mientras pruebas):
SITE_ADDRESS=:80

HTTP_PORT=80
HTTPS_PORT=443

# Origen(es) permitido(s) por CORS (separa varios con comas, sin barra final):
# Ejemplo con dominio HTTPS:
# SENIOR_MANAGE_FRONTEND_ORIGIN=https://app.tudominio.com
SENIOR_MANAGE_FRONTEND_ORIGIN=http://localhost

# Ruta de la API usada por el frontend en compilacion (proxy Nginx /api -> backend:8080/api):
VITE_API_URL=/api

# -----------------------------------------------------------------------------
# 2. PostgreSQL 16 (solo accesible en la red interna de Docker)
# -----------------------------------------------------------------------------
POSTGRES_DB=senior_manage
POSTGRES_USER=senior_manage
# Genera una contrasena fuerte, por ejemplo con: openssl rand -hex 24
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_POSTGRES_SEGURA

# -----------------------------------------------------------------------------
# 3. Seguridad JWT del Backend (HS256)
# -----------------------------------------------------------------------------
# Secreto obligatorio de al menos 32 bytes. Genera uno con: openssl rand -base64 48
SENIOR_MANAGE_JWT_SECRET=CAMBIA_ESTE_SECRETO_JWT_DE_AL_MENOS_32_BYTES_LARGO
SENIOR_MANAGE_JWT_KEY_ID=key-2026-11
SENIOR_MANAGE_JWT_ISSUER=senior-manage-api
SENIOR_MANAGE_JWT_AUDIENCE=senior-manage-web

# -----------------------------------------------------------------------------
# 4. Auto-bootstrap de migraciones, administrador inicial y matriz de permisos
# -----------------------------------------------------------------------------
SENIOR_MANAGE_AUTO_BOOTSTRAP=true
SENIOR_MANAGE_PERMISSION_MATRIX_SHA256=6EDB8C419013B86D62BABAC0A9D1F9668918158AA332AA7BF5B46B9EE60FA969

# Datos del administrador inicial (se crea solo si aun no existe en la BD; minimo 12 caracteres):
SENIOR_MANAGE_INITIAL_ADMIN_NAME=Administrador Principal
SENIOR_MANAGE_INITIAL_ADMIN_EMAIL=admin@tudominio.com
SENIOR_MANAGE_INITIAL_ADMIN_PASSWORD=CAMBIA_CLAVE_ADMIN_MINIMO_12_CARACTERES

