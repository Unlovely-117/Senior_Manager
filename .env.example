# Senior-Manage - Variables de Entorno Locales
# Copia este archivo como .env.local para configurar tus credenciales de desarrollo.
# .env.local está ignorado por Git para proteger tus credenciales.

# Conexión PostgreSQL
SENIOR_MANAGE_JDBC_URL=jdbc:postgresql://localhost:5432/senior_manager_migration_dev
SENIOR_MANAGE_DB_USERNAME=senior_manager_app
SENIOR_MANAGE_DB_PASSWORD=

# Configuración del servidor (opcional)
SENIOR_MANAGE_PORT=8080

# Comportamiento del script de inicio
AUTO_OPEN_BROWSER=true

